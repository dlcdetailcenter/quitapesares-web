{
  "$comentario": "Configuración de PRUEBA para el clip sintético (scripts/media/clip-prueba.mjs). Mismos ajustes que tramos.json; solo cambian los tramos. No describe ningún clip real.",
  "salida": { "ancho": 720, "alto": 1280, "fps": 30 },
  "tonemap": { "operador": "hable", "npl": 100, "desat": 0 },
  "color": {
    "eq": "contrast=1.0:brightness=0.0:saturation=1.0:gamma=1.0",
    "ruido": "hqdn3d=1.5:1.5:4:4",
    "nitidez": "unsharp=5:5:0.25:5:5:0.0"
  },
  "estabilizacion": { "shakiness": 5, "accuracy": 15, "smoothing": 20 },
  "exportar": {
    "canvas": { "formato": "webp", "calidad": 62 },
    "video": { "crf": 26, "gop": 4 }
  },
  "tramos": [
    {
      "id": "prueba",
      "clip": "SINTETICO",
      "inicio": 1,
      "fin": 4,
      "recorte": null,
      "velocidad": 1,
      "difuminados": [{ "x": 20, "y": 1000, "ancho": 160, "alto": 160, "desde": 0, "hasta": 1.5 }],
      "barridoFinal": { "segundos": 0.5, "factor": 2, "mezcla": 5 },
      "notas": "Prueba del pipeline completo, con un difuminado y un barrido."
    }
  ]
}
