{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "quitapesares-web",
  // Fecha fija para que el comportamiento no cambie al actualizar dependencias.
  // Es la más reciente que admite el workerd instalado (1.20261023.1).
  "compatibility_date": "2026-10-23",
  // Registro de errores en Cloudflare cuando se despliegue (las trazas se deciden en la fase de despliegue).
  "observability": {
    "enabled": true
  }
}
