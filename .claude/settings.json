{
  "permissions": {
    "ask": [
      "Bash(git push *)",
      "Bash(git * push *)",
      "Bash(gh pr create *)",
      "Bash(gh pr merge *)",
      "Bash(gh pr close *)",
      "Bash(gh pr edit *)",
      "Bash(gh pr comment *)",
      "Bash(gh pr review *)",
      "Bash(gh pr ready *)",
      "Bash(gh repo *)",
      "Bash(gh api *)",
      "Bash(gh release *)",
      "Bash(gh workflow *)",
      "Bash(gh secret *)",
      "Bash(gh variable *)",
      "Bash(gh ruleset *)",
      "Bash(gh pr reopen *)",
      "Bash(gh pr update-branch *)",
      "Bash(gh pr lock *)",
      "Bash(gh run *)",
      "Bash(gh cache *)",
      "PowerShell(git push *)",
      "PowerShell(git * push *)",
      "PowerShell(gh pr create *)",
      "PowerShell(gh pr merge *)",
      "PowerShell(gh pr close *)",
      "PowerShell(gh pr edit *)",
      "PowerShell(gh pr comment *)",
      "PowerShell(gh pr review *)",
      "PowerShell(gh pr ready *)",
      "PowerShell(gh repo *)",
      "PowerShell(gh api *)",
      "PowerShell(gh release *)",
      "PowerShell(gh workflow *)",
      "PowerShell(gh secret *)",
      "PowerShell(gh variable *)",
      "PowerShell(gh ruleset *)",
      "PowerShell(gh pr reopen *)",
      "PowerShell(gh pr update-branch *)",
      "PowerShell(gh pr lock *)",
      "PowerShell(gh run *)",
      "PowerShell(gh cache *)"
    ],
    "disableBypassPermissionsMode": "disable"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/sin-saltarse-barreras.mjs"],
            "onFailure": "block",
            "statusMessage": "Comprobando que el comando no apaga las barreras"
          }
        ]
      }
    ]
  }
}
