---
// La carta del día en un idioma. Se renderiza en el servidor en cada petición: lee la última versión válida
// de KV (la actualiza la tarea programada cada minuto). Detalle de las fuentes en src/lib/carta/fuente.ts.
import { env } from 'cloudflare:workers';
import plantilla from '../../docs/carta/plantilla-hoja-carta.csv?raw';
import Base from '../layouts/Base.astro';
import Pizarra from './Pizarra.astro';
import { CATEGORIAS_TRADUCIDAS, TEXTOS } from '../i18n/textos.ts';
import { agrupar, type Idioma } from '../lib/carta/hoja.ts';
import { cartaParaMostrar } from '../lib/carta/fuente.ts';
import { local } from '../lib/local.ts';

interface Props {
  idioma: Idioma;
}

const { idioma } = Astro.props;
const t = TEXTOS[idioma];

const carta = await cartaParaMostrar(env, Astro.url, plantilla, (promesa) => Astro.locals.cfContext.waitUntil(promesa));
const grupos = carta ? agrupar(carta, idioma) : [];
const hayEnEspanol = carta ? agrupar(carta, 'es').length > 0 : false;

// La plantilla de prueba no tiene hora real (fecha 0): entonces no se muestra.
const actualizada = carta && Date.parse(carta.actualizada) > 0 ? new Date(carta.actualizada) : null;
const hora = actualizada
  ? new Intl.DateTimeFormat(idioma === 'es' ? 'es-ES' : 'en-GB', {
      timeZone: 'Europe/Madrid',
      day: 'numeric',
      month: 'long',
      hour: '2-digit',
      minute: '2-digit',
    }).format(actualizada)
  : null;
---

<Base idioma={idioma} titulo={t.tituloCarta} rutaOtroIdioma={idioma === 'es' ? '/en/carta' : '/carta'}>
  <div class="contenedor carta">
    <h1>{t.carta}</h1>

    {
      grupos.length > 0 && (
        <nav class="carta__pestanas" aria-label={t.navSecciones}>
          <a href="#menu-del-dia">{t.menuDelDia}</a>
          {grupos.map((grupo, i) => (
            <a href={`#categoria-${i + 1}`} data-pestana={i}>
              {CATEGORIAS_TRADUCIDAS[idioma][grupo.categoria]}
            </a>
          ))}
        </nav>
      )
    }

    <Pizarra idioma={idioma} id="menu-del-dia" />

    {
      grupos.map((grupo, i) => (
        <details class="carta__grupo" open={i === 0} aria-labelledby={`categoria-${i + 1}`}>
          <summary>
            <h2 id={`categoria-${i + 1}`}>{CATEGORIAS_TRADUCIDAS[idioma][grupo.categoria]}</h2>
          </summary>
          <ul class="carta__platos">
            {grupo.platos.map((plato) => (
              <li class:list={['carta__plato', { 'carta__plato--agotado': !plato.disponible }]}>
                <span class="carta__nombre">{plato.nombre}</span>
                {!plato.disponible && <span class="carta__agotado">{t.agotado}</span>}
              </li>
            ))}
          </ul>
        </details>
      ))
    }

    {
      grupos.length === 0 && idioma === 'en' && hayEnEspanol && (
        <section class="carta__aviso" aria-labelledby="aviso-carta">
          <h2 id="aviso-carta">{t.cartaSinIngles}</h2>
          <p>
            <a class="boton boton--borde" href="/carta" hreflang="es">
              {t.verCartaEnOtroIdioma}
            </a>
          </p>
        </section>
      )
    }

    {
      grupos.length === 0 && !(idioma === 'en' && hayEnEspanol) && (
        <section class="carta__aviso" aria-labelledby="aviso-carta">
          <h2 id="aviso-carta">{t.sinCartaTitulo}</h2>
          <p>{t.sinCartaTexto}</p>
          <p>
            <a class="boton" href={local.telefonoHref}>
              {t.llamar}: {local.telefono}
            </a>
          </p>
        </section>
      )
    }

    {
      hora && actualizada && grupos.length > 0 && (
        <p class="carta__actualizada">
          {t.ultimoCambio} <time datetime={actualizada.toISOString()}>{hora}</time>
        </p>
      )
    }

    <details class="alergenos">
      <summary>{t.alergenos}</summary>
      <p>{t.alergenosTexto}</p>
    </details>

    <p class="carta__llamar">
      <a class="boton" href={local.telefonoHref}>{t.llamar}</a>
    </p>
  </div>
</Base>

<script is:inline>
  // Una pestaña abre su desplegable antes de que el navegador baje hasta él. Sin esto, se abre a mano.
  document.querySelectorAll('[data-pestana]').forEach(function (a) {
    a.addEventListener('click', function () {
      var titulo = document.getElementById(a.getAttribute('href').slice(1));
      var grupo = titulo && titulo.closest('details');
      if (grupo) grupo.open = true;
    });
  });
</script>

<style>
  .carta {
    padding-top: calc(var(--alto-cabecera) + 2rem);
    padding-bottom: 2rem;
  }

  h1 {
    font-family: var(--fuente-rotulo-pila);
    font-size: 3.25rem;
    color: var(--burdeos);
    text-align: center;
  }

  /* Pestañas: se desplazan de lado sin mover la página. */
  .carta__pestanas {
    position: sticky;
    top: var(--alto-cabecera);
    z-index: 5;
    display: flex;
    gap: 1.25rem;
    margin: 1rem calc(var(--hueco) * -1) 2rem;
    padding: 0 var(--hueco);
    overflow-x: auto;
    background: var(--crema);
    border-bottom: 1px solid var(--burdeos);
    scrollbar-width: none;
  }

  .carta__pestanas a {
    flex: none;
    display: inline-flex;
    align-items: center;
    min-height: var(--toque);
    color: var(--madera);
    font-family: var(--fuente-versalitas-pila);
    font-size: 1rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-decoration: none;
  }

  .carta__pestanas a:hover {
    color: var(--burdeos);
  }

  .carta__pestanas a:focus-visible {
    outline-offset: -3px;
  }

  .carta__grupo {
    margin-top: 2rem;
    border-bottom: 1px solid var(--burdeos);
  }

  .carta__grupo summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 3.5rem;
    list-style: none;
    cursor: pointer;
    color: var(--burdeos);
  }

  .carta__grupo summary::-webkit-details-marker {
    display: none;
  }

  /* El signo dice si está abierto o cerrado. */
  .carta__grupo summary::after {
    content: '+';
    content: '+' / '';
    flex: none;
    font-size: 1.75rem;
    line-height: 1;
  }

  .carta__grupo[open] summary::after {
    content: '−';
    content: '−' / '';
  }

  .carta__grupo h2,
  .carta__aviso h2 {
    font-size: 1.375rem;
  }

  .carta__platos {
    list-style: none;
    margin: 0 0 1rem;
    padding: 0;
  }

  .carta__plato {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.25rem 0.75rem;
    padding: 0.625rem 0;
  }

  .carta__plato + .carta__plato {
    border-top: 1px solid var(--ocre);
  }

  .carta__plato--agotado .carta__nombre {
    color: var(--texto-suave);
  }

  .carta__agotado {
    flex: none;
    padding: 0 0.5rem;
    border: 1px solid var(--burdeos);
    color: var(--burdeos);
    font-family: var(--fuente-versalitas-pila);
    font-size: 1rem;
    font-weight: 500;
  }

  .carta__aviso {
    margin-top: 2rem;
  }

  .carta__aviso p {
    margin: 0.75rem 0 0;
  }

  .carta__actualizada {
    margin: 1.5rem 0 0;
    color: var(--texto-suave);
    font-size: 1rem;
  }

  .carta__llamar {
    margin: 0;
  }
</style>
