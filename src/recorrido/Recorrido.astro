---
// Recorrido de F2 como capa sobre la portada de F1. Sin JavaScript, o con «reducir movimiento», ahorro de datos o red
// lenta, la sección no se muestra y la portada es la de F1 más la barra «Ir a la carta».
// Textos: el nombre y los datos salen de src/data/restaurante.json; los de interfaz, de src/i18n/textos.ts.
import Flecha from './Flecha.astro';
import PlatosHoy from './PlatosHoy.astro';
import { NOMBRES_DIAS, TEXTOS, palabraDatos } from '../i18n/textos.ts';
import type { Idioma } from '../lib/carta/hoja.ts';
import { local } from '../lib/local.ts';

interface Props {
  idioma: Idioma;
}

const { idioma } = Astro.props;
const t = TEXTOS[idioma];
const rutaCarta = idioma === 'es' ? '/carta' : '/en/carta';
---

<section class="recorrido" data-recorrido aria-label={t.recorrido}>
  <div class="recorrido__pista" data-recorrido-pista>
    <div class="recorrido__escena">
      <canvas class="recorrido__lienzo" data-recorrido-lienzo aria-hidden="true"></canvas>
      <div class="recorrido__rotulos" data-rotulo="aire" aria-hidden="true">
        <!-- Nombre completo como en la portada: «Restaurante» en pequeño encima y el nombre en gótica. El espacio entre
             los dos trozos va escrito para que el texto sea el nombre del archivo de datos y no «RestauranteQuitapesares». -->
        <p class="recorrido__rotulo">
          {local.tipoDeLocal && <span class="recorrido__tipo">{local.tipoDeLocal}</span>}{local.tipoDeLocal && ' '}<span>{local.nombreCorto}</span>
        </p>
        <!-- La orla de la casa y, debajo, una flecha que baja: aquí se sigue con el dedo. -->
        <i class="orla recorrido__orla"><i></i></i>
        <i class="recorrido__baja"></i>
      </div>
      <p class="recorrido__pnoa" data-recorrido-pnoa hidden>
        <!-- El texto va en un solo span: el enlace es flex y, sin él, se perdían los espacios a los lados del año. -->
        <a href="https://www.scne.es/"><span>{t.pnoaPrefijo} <span data-anio></span> CC-BY 4.0 scne.es</span></a>
      </p>
      <!-- Un grupo de acciones por zona, fijo mientras se ve (cliente.ts): son las acciones que ya existen en la
           portada, cada una con su dato del archivo. Fuera de su zona no se ven ni se pueden enfocar. -->
      <nav class="recorrido__parada" data-parada="llegar" aria-label={t.comoLlegar}>
        <div class="recorrido__marco">
          <a class="recorrido__accion" href={local.comoLlegarHref}>
            <span class="recorrido__texto">
              <span class="recorrido__titulo">{t.comoLlegar}</span>{' '}
              <span class="recorrido__dato">{local.direccion}</span>
            </span>
            <Flecha />
          </a>
        </div>
      </nav>
      <nav class="recorrido__parada" data-parada="menu" aria-label={t.menuDelDia}>
        <div class="recorrido__marco">
          <a class="recorrido__menu toldo" href={`${rutaCarta}#menu-del-dia`}>
            <span class="recorrido__titulo">{t.menuDelDia}</span>{' '}
            <span class="recorrido__precio">{local.precioMenuDiario(idioma)}</span>
          </a>
          <div class="recorrido__cuerpo">
            <p class="recorrido__subtitulo">{t.platosHoy}</p>
            <PlatosHoy idioma={idioma} conCarta />
          </div>
        </div>
      </nav>
      <nav class="recorrido__parada" data-parada="llamar" aria-label={t.llamar}>
        <div class="recorrido__marco">
          <a class="recorrido__accion" href={local.telefonoHref}>
            <span class="recorrido__texto">
              <span class="recorrido__titulo">{t.llamar}</span>{' '}
              <span class="recorrido__dato">{local.telefono}</span>
            </span>
            <Flecha />
          </a>
          {
            local.horario.map(({ dia, horas }) => (
              <p class="recorrido__horario" data-dia-en={NOMBRES_DIAS.en[dia].toLowerCase()} hidden>
                {t.horarioHoy}: {palabraDatos(horas, idioma)}
              </p>
            ))
          }
        </div>
      </nav>
      <nav class="recorrido__parada" data-parada="resena" aria-label={t.dejarResena}>
        <div class="recorrido__marco">
          <a class="recorrido__accion" href={local.resenaHref}>
            <span class="recorrido__titulo">{t.dejarResena}</span>
            <Flecha />
          </a>
        </div>
      </nav>
    </div>
  </div>
  <!-- Solo con el material de prueba de la CI: dice que todavía no es el del local. -->
  <div class="recorrido__creditos" data-recorrido-sintetico hidden>
    <p>{t.creditosSintetico}</p>
  </div>
</section>

<script>
  import './cliente.ts';
</script>

<style>
  .recorrido {
    display: none;
    background: #1b1410;
    color: #fff;
  }

  .recorrido__pista {
    position: relative;
    height: 100svh;
  }

  :global(html.recorrido-pendiente) .recorrido,
  :global(html.recorrido-activo) .recorrido {
    display: block;
  }

  :global(html.recorrido-activo) .recorrido__pista {
    height: calc(var(--recorrido-pantallas, 1) * 100svh);
  }

  .recorrido__escena {
    position: sticky;
    top: 0;
    height: 100svh;
    overflow: hidden;
  }

  .recorrido__lienzo {
    display: block;
    width: 100%;
    height: 100%;
  }

  /* Sombra arriba y abajo: asienta la cabecera y el panel sobre la imagen, y da contraste al nombre. */
  .recorrido__escena::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(rgb(27 20 16 / 0.4), rgb(27 20 16 / 0) 26%, rgb(27 20 16 / 0) 52%, rgb(27 20 16 / 0.5));
    pointer-events: none;
  }

  .recorrido__rotulos {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: grid;
    align-content: center;
    justify-items: center;
    padding-bottom: 7rem;
    color: var(--crema-clara);
    pointer-events: none;
  }

  /* El nombre, como en la placa de la fachada: «Restaurante» en versalitas y el nombre en gótica. */
  .recorrido__rotulo {
    margin: 0;
    padding: 0 1rem;
    font-family: var(--fuente-rotulo-pila);
    font-size: clamp(3.75rem, 19vw, 6rem);
    line-height: 1;
    text-align: center;
    text-shadow: 0 2px 18px rgb(0 0 0 / 0.75);
  }

  .recorrido__tipo {
    display: block;
    margin-bottom: 0.375rem;
    font-family: var(--fuente-versalitas-pila);
    font-size: 1.25rem;
    font-weight: 500;
    letter-spacing: 0.16em;
  }

  .recorrido__orla {
    width: 9rem;
    margin-top: 1rem;
    color: inherit;
    filter: drop-shadow(0 1px 6px rgb(0 0 0 / 0.8));
  }

  /* Flecha que baja despacio: el único movimiento que no responde al dedo. */
  .recorrido__baja {
    width: 1px;
    height: 2.5rem;
    margin-top: 1.25rem;
    background: currentColor;
    filter: drop-shadow(0 1px 6px rgb(0 0 0 / 0.8));
    animation: baja 2.4s ease-in-out infinite;
  }

  .recorrido__baja::after {
    content: '';
    display: block;
    width: 0.5rem;
    height: 0.5rem;
    margin: calc(2.5rem - 0.5rem) 0 0 calc(-0.25rem + 0.5px);
    border: solid currentColor;
    border-width: 0 1px 1px 0;
    transform: rotate(45deg);
  }

  @keyframes baja {
    50% {
      transform: translateY(0.5rem);
    }
  }

  /* Atribución de la ortofoto: la exige su licencia. Discreta, arriba a la izquierda, mientras se ve el suelo. */
  .recorrido__pnoa {
    position: absolute;
    left: 0;
    top: var(--alto-cabecera);
    z-index: 1;
    margin: 0;
    padding: 0.375rem var(--hueco) 0;
    font-size: 0.8125rem;
    line-height: 1.3;
  }

  .recorrido__pnoa a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0 0.625rem;
    color: var(--crema-clara);
    background: rgb(27 20 16 / 0.6);
    text-decoration-color: rgb(250 243 223 / 0.5);
  }

  .recorrido__pnoa--oculta {
    visibility: hidden;
  }

  /* Panel de acciones: tarjeta clara con doble filete, sobre la imagen y encima de la barra «Ir a la carta». */
  .recorrido__parada {
    position: absolute;
    left: var(--hueco);
    right: var(--hueco);
    bottom: calc(5rem + env(safe-area-inset-bottom));
    z-index: 2;
    max-width: var(--ancho);
    margin: 0 auto;
    padding: 0.3125rem;
    border: 1px solid var(--burdeos);
    background: var(--crema-clara);
    color: var(--madera);
    box-shadow: 0 0.75rem 2rem rgb(27 20 16 / 0.35);
    visibility: hidden;
    opacity: 0;
    transition: opacity 0.2s ease, visibility 0s 0.2s;
  }

  .recorrido__parada--visible {
    visibility: visible;
    opacity: 1;
    transition: opacity 0.2s ease;
  }

  /* El filete interior: lo que va dentro llega hasta él. */
  .recorrido__marco {
    border: 1px solid var(--burdeos);
  }

  /* Fila de acción: lo que hace, su dato debajo y la flecha. */
  .recorrido__accion,
  .recorrido__menu {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 4rem;
    padding: 0.625rem 1rem;
    color: var(--burdeos);
    text-decoration: none;
  }

  .recorrido__texto {
    display: grid;
    gap: 0.125rem;
  }

  .recorrido__titulo {
    font-family: var(--fuente-versalitas-pila);
    font-size: 1.25rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    line-height: 1.2;
  }

  .recorrido__dato {
    color: var(--madera);
    font-size: 1.125rem;
    line-height: 1.35;
    font-variant-numeric: lining-nums tabular-nums;
  }

  .recorrido__accion :global(svg) {
    flex: none;
    width: 3.5rem;
    height: 0.75rem;
    transition: transform 0.2s ease;
  }

  .recorrido__accion:hover :global(svg),
  .recorrido__accion:active :global(svg) {
    transform: translateX(0.25rem);
  }

  /* El menú del día, en el burdeos de la pizarra y bajo el toldo (.toldo, más pequeño): lleva a la carta. */
  .recorrido__menu {
    --franja: 1rem;
    align-items: baseline;
    padding-top: 2.125rem;
    background: var(--burdeos);
    color: var(--crema-clara);
  }

  .recorrido__menu:focus-visible {
    outline-color: var(--crema);
    outline-offset: -5px;
  }

  .recorrido__precio {
    flex: none;
    font-family: var(--fuente-versalitas-pila);
    font-size: 1.75rem;
    font-weight: 500;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }

  .recorrido__cuerpo {
    padding: 0.5rem 1rem 0;
  }

  .recorrido__subtitulo {
    margin: 0.25rem 0 0.125rem;
    color: var(--texto-suave);
    font-family: var(--fuente-versalitas-pila);
    font-size: 1.0625rem;
    font-weight: 500;
    letter-spacing: 0.08em;
  }

  /* Sin platos (ruta caída o carta vacía) no hay título: queda «Ver carta». */
  .recorrido__subtitulo:has(+ :global(.hoy) > :global(.hoy__platos[hidden])) {
    display: none;
  }

  .recorrido__horario {
    margin: 0;
    padding: 0.625rem 1rem 0.75rem;
    font-size: 1.125rem;
    font-variant-numeric: lining-nums tabular-nums;
  }

  .recorrido__horario::before {
    content: '';
    display: block;
    margin-bottom: 0.625rem;
    border-top: 1px solid var(--ocre);
  }

  .recorrido__creditos {
    padding: 1rem var(--hueco);
    background: var(--crema);
    color: var(--texto-suave);
    font-size: 0.9375rem;
  }

  .recorrido__creditos p {
    max-width: var(--ancho);
    margin: 0 auto;
  }

  .recorrido__creditos[hidden],
  :global(html.recorrido-pendiente) .recorrido__creditos {
    display: none;
  }
</style>
