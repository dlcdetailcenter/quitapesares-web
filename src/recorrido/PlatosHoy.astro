---
// «Platos de hoy»: lista que rellena src/recorrido/hoy.ts. Sin ella (ruta caída o sin platos), queda «Ver carta».
import Flecha from './Flecha.astro';
import { TEXTOS } from '../i18n/textos.ts';
import type { Idioma } from '../lib/carta/hoja.ts';

interface Props {
  idioma: Idioma;
}

const { idioma } = Astro.props;
const t = TEXTOS[idioma];
---

<div class="hoy" data-hoy>
  <ul class="hoy__platos" hidden></ul>
  <a class="hoy__carta" href={idioma === 'es' ? '/carta' : '/en/carta'}>
    {t.verCarta}
    <Flecha />
  </a>
</div>

<script>
  import './hoy.ts';
</script>
